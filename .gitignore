# SkillSprint AI - Git Ignore Rules (.gitignore)

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Database Files
*.db
*.sqlite
*.sqlite3

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo

# Node / Frontend Build Outputs
frontend/node_modules/
frontend/dist/
frontend/build/
.npm

# Logs & Temporary Files
*.log
logs/
tmp/
scratch/

# OS Specific
.DS_Store
Thumbs.db
