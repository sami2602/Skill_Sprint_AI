# SkillSprint AI — Environment Configuration Template (.env.example)

# App Configuration
APP_NAME="SkillSprint AI"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Generative AI API Keys
GEMINI_API_KEY="your_google_gemini_api_key_here"
OPENAI_API_KEY="optional_openai_api_key_here"
PRIMARY_GENAI_MODEL="gemini-2.5-flash"

# Security & Authentication
JWT_SECRET_KEY="super_secret_jwt_signature_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection
# SQLite local development database:
DATABASE_URL="sqlite:///./skillsprint_ai.db"
# PostgreSQL production database:
# DATABASE_URL="postgresql://user:password@localhost:5432/skillsprint_db"

# Storage Settings
UPLOAD_DIR="./data/documents"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25MB

# Verification & Retry Settings
MAX_GENAI_RETRIES=3
GENAI_RETRY_BACKOFF_FACTOR=2.0
REQUIRE_MANDATORY_COVERAGE_PERCENT=100.0
REQUIRE_TRACEABILITY_PERCENT=100.0
